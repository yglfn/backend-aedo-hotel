APP_NAME="Aedo Hotel Syariah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# URL frontend SPA (harus satu domain induk dengan API agar cookie session berfungsi)
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aedo_hotel
DB_USERNAME=root
DB_PASSWORD=

# Database TERPISAH untuk otomatis test (dipakai oleh phpunit.xml).
# Buat sekali sebelum menjalankan `php artisan test`:
#   CREATE DATABASE aedo_hotel_testing CHARACTER SET utf8mb4;
DB_DATABASE_TESTING=aedo_hotel_testing

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum SPA: daftar domain frontend yang boleh mengirim cookie session
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment Gateway (AGENTS.md bagian 7). Pilihan: simulator | sandbox | midtrans
# AppServiceProvider MENOLAK boot kalau provider belum diimplementasikan atau
# simulator dipasang di produksi.
PG_PROVIDER=simulator
PG_SIMULATOR_SECRET=ubah-ini-jangan-pakai-default

# Midtrans (Snap API). Kunci diambil dari Midtrans Merchant Account > Access Keys:
# pilih tab Development/Sandbox Keys untuk sandbox, Production Keys untuk live.
# Prefiks kunci TIDAK dipakai untuk menentukan environment (Midtrans punya beberapa gaya
# penamaan: SB-Mid-server-... dan Mid-server-...). Set PG_MIDTRANS_IS_PRODUCTION dengan benar,
# lalu pastikan kunci diterima dengan: php artisan payment:test-connection
# (jawaban berasal dari server Midtrans sungguhan, bukan tebakan kode).
# PG_MIDTRANS_SIGNATURE_KEY opsional; kalau kosong, signature dihitung dengan Server Key
# (sesuai dokumentasi resmi Midtrans). URL notifikasi: https://<domain>/api/webhooks/payment-gateway
# Catatan host (diverifikasi langsung): Snap = app.sandbox.midtrans.com, cek status = api.sandbox.midtrans.com.
PG_MIDTRANS_SERVER_KEY=
PG_MIDTRANS_CLIENT_KEY=
PG_MIDTRANS_SIGNATURE_KEY=
PG_MIDTRANS_IS_PRODUCTION=false

# Halaman hasil pembayaran yang dituju setelah tamu selesai di halaman Midtrans.
# Dikirim sebagai callbacks.finish dan MENIMPA "Finish Redirect URL" di dashboard Midtrans
# (default dashboard = https://example.com, itulah yang membuat tamu dibuang ke sana).
# Dikosongkan = otomatis pakai FRONTEND_URL + /payment-result.
PG_MIDTRANS_FINISH_URL=

# Untuk provider lain yang belum dipasang (Xendit/Tripay/DOKU), kosongkan saja.
PG_API_KEY=
PG_SECRET_KEY=
PG_CLIENT_KEY=
