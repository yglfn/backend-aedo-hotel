APP_NAME="Aedo Hotel Syariah"
APP_ENV=production
APP_KEY=base64:Sm7L/ZeeCnnHoCzzJ27azIS4xSwO2ohvZq8z3q/9O1Q=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://backend-aedo-hotel.ethiodeploy.app

# URL Frontend (Cloudflare Workers)
FRONTEND_URL=https://frontend-aedo-hotel.yogielfino.workers.dev

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database (Ganti sesuai database hosting Anda / Railway MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aedo_hotel
DB_USERNAME=root
DB_PASSWORD=

# Session & Cookie untuk Cross-Domain (workers.dev -> ethiodeploy.app)
SESSION_DRIVER=cookie
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# Sanctum Stateful Domains (HANYA hostname, tanpa https:// dan tanpa slash)
SANCTUM_STATEFUL_DOMAINS=frontend-aedo-hotel.yogielfino.workers.dev,backend-aedo-hotel.ethiodeploy.app

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=
