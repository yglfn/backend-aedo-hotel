{
  "info": {
    "name": "Aedo Hotel Syariah API",
    "description": "Koleksi lengkap endpoint backend Aedo Hotel Syariah.\nBasis URL: {{base_url}}\n\n**Setup sebelum mulai:**\n1. Jalankan request '00. Init CSRF' terlebih dahulu\n2. Lalu jalankan 'Login sebagai Admin'\n3. Semua request berikutnya sudah otomatis terautentikasi via cookie",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "customer_id", "value": "", "type": "string" },
    { "key": "room_type_id", "value": "", "type": "string" },
    { "key": "room_id", "value": "", "type": "string" },
    { "key": "service_id", "value": "", "type": "string" },
    { "key": "booking_id", "value": "", "type": "string" },
    { "key": "invoice_id", "value": "", "type": "string" },
    { "key": "payment_id", "value": "", "type": "string" },
    { "key": "shift_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "maintenance_id", "value": "", "type": "string" },
    { "key": "housekeeping_id", "value": "", "type": "string" },
    { "key": "notification_id", "value": "", "type": "string" },
    { "key": "xsrf_token", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sanctum perlu header Referer agar request dianggap stateful (SPA) dan mengecek session cookie",
          "pm.request.headers.upsert({",
          "    key: 'Referer',",
          "    value: pm.collectionVariables.get('base_url')",
          "});",
          "",
          "// Otomatis sertakan X-XSRF-TOKEN dari cookie ke setiap request",
          "const jar = pm.cookies.toObject();",
          "const xsrf = jar['XSRF-TOKEN'] || pm.collectionVariables.get('xsrf_token');",
          "if (xsrf) {",
          "    pm.request.headers.upsert({",
          "        key: 'X-XSRF-TOKEN',",
          "        value: decodeURIComponent(xsrf)",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. Init & Auth",
      "item": [
        {
          "name": "00. Init CSRF Cookie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "// Simpan XSRF-TOKEN ke variable",
                  "const jar = pm.cookies.toObject();",
                  "if (jar['XSRF-TOKEN']) {",
                  "    pm.collectionVariables.set('xsrf_token', jar['XSRF-TOKEN']);",
                  "    console.log('CSRF token disiapkan');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/sanctum/csrf-cookie", "host": ["{{base_url}}"], "path": ["sanctum", "csrf-cookie"] }
          }
        },
        {
          "name": "01. Login sebagai Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login berhasil', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "    pm.collectionVariables.set('user_id', res.data.id);",
                  "    console.log('Login sebagai:', res.data.name, '| Role:', res.data.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@aedohotel.com\",\n  \"password\": \"password\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "02. Login sebagai Pegawai",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"pegawai@aedohotel.com\",\n  \"password\": \"password\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "03. Me (Profil Login)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "04. Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
