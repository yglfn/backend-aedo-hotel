    {
      "name": "12. Payment Gateway",
      "item": [
        {
          "name": "Buat QRIS Gateway Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "    pm.collectionVariables.set('payment_id', res.data.id);",
                  "    pm.collectionVariables.set('gateway_transaction_id', res.data.gateway_transaction_id);",
                  "    console.log('Transaction ID:', res.data.gateway_transaction_id);",
                  "    console.log('QR String:', res.payment_info ? res.payment_info.qr_string : '-');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"channel\": \"qris\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}/payments/gateway", "host": ["{{base_url}}"], "path": ["api", "v1", "bookings", "{{booking_id}}", "payments", "gateway"] }
          }
        },
        {
          "name": "Buat VA Gateway Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"channel\": \"va\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}/payments/gateway", "host": ["{{base_url}}"], "path": ["api", "v1", "bookings", "{{booking_id}}", "payments", "gateway"] }
          }
        },
        {
          "name": "Simulasi Webhook Bayar Berhasil",
          "description": "Simulasikan callback dari payment gateway seolah tamu sudah bayar.\nGanti {{gateway_transaction_id}} dengan nilai yang sudah tersimpan.\n\nSignature dihitung: HMAC-SHA256(payload, 'simulator-secret-key-aedo-hotel')",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Hitung HMAC-SHA256 signature untuk simulator",
                  "const txId = pm.collectionVariables.get('gateway_transaction_id');",
                  "const payload = JSON.stringify({",
                  "    transaction_id: txId,",
                  "    event: 'payment.paid',",
                  "    status: 'paid'",
                  "});",
                  "",
                  "// Simpan payload ke variable agar bisa dipakai di body",
                  "pm.collectionVariables.set('webhook_payload', payload);",
                  "",
                  "// Hitung HMAC (Postman CryptoJS)",
                  "const secret = 'simulator-secret-key-aedo-hotel';",
                  "const signature = CryptoJS.HmacSHA256(payload, secret).toString();",
                  "pm.collectionVariables.set('webhook_signature', signature);",
                  "console.log('Payload:', payload);",
                  "console.log('Signature:', signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook diproses', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(['processed', 'skipped']).to.include(res.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Simulator-Signature", "value": "{{webhook_signature}}" }
            ],
            "body": { "mode": "raw", "raw": "{{webhook_payload}}" },
            "url": { "raw": "{{base_url}}/api/webhooks/payment-gateway", "host": ["{{base_url}}"], "path": ["api", "webhooks", "payment-gateway"] }
          }
        },
        {
          "name": "List Log Gateway (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/payment-gateway-logs?processed=true",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payment-gateway-logs"],
              "query": [{ "key": "processed", "value": "true" }]
            }
          }
        }
      ]
