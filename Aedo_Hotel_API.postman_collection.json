            "url": { "raw": "{{base_url}}/api/v1/users/{{user_id}}/deactivate", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "{{user_id}}", "deactivate"] }
          }
        },
        {
          "name": "Aktifkan User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/users/{{user_id}}/activate", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "{{user_id}}", "activate"] }
          }
        },
        {
          "name": "Reset Password User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/users/{{user_id}}/reset-password", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "{{user_id}}", "reset-password"] }
          }
        }
      ]
    },
