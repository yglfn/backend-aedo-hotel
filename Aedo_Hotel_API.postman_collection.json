{
    "info": {
        "_postman_id": "aedo-hotel-api-laragon",
        "name": "Aedo Hotel Syariah API (Laragon)",
        "description": "Koleksi Postman untuk testing API Aedo Hotel Syariah dengan autentikasi Sanctum SPA di environment Laragon.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "1. Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Login berhasil (200)', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "if (pm.response.code === 200) {",
                                    "    var json = pm.response.json();",
                                    "    pm.environment.set('auth_token', json.token);",
                                    "    pm.environment.set('user_id', json.user.id);",
                                    "    pm.environment.set('user_role', json.user.role);",
                                    "    console.log('Token saved! Role: ' + json.user.role);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@aedohotel.com\",\n    \"password\": \"password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "2. Get Me (Profil)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/me",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "me"
                            ]
                        }
                    }
                },
                {
                    "name": "3. Logout",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/logout",
                            "host": [
