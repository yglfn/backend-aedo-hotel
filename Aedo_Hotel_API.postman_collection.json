            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pegawai Update\",\n  \"email\": \"pegawai.update@aedohotel.com\",\n  \"role\": \"pegawai\",\n  \"is_active\": true\n}" },
            "url": { "raw": "{{base_url}}/api/v1/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "{{user_id}}"] }
